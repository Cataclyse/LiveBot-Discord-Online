{
  "name": "livebot-discord-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --check app.js && node --check discord.js && node --check message-content.js && node --check message-model.js && node --check context-menu.js && node --check media.js && node --check relay/worker.js && node --test test/*.test.js",
    "vendor:build": "node scripts/build-vendor.js",
    "start": "node scripts/serve.js",
    "relay:login": "wrangler login",
    "relay:whoami": "wrangler whoami",
    "relay:check": "wrangler deploy --config relay/wrangler.toml --dry-run --outdir .wrangler/relay-preview",
    "relay:deploy": "wrangler deploy --config relay/wrangler.toml"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "wrangler": "^4.151.0"
  }
}
